index=windows (source="XmlWinEventLog:Security" OR source="WinEventLog:Security") (EventCode=4624 OR EventCode=4625)
| eval account=coalesce(TargetUserName, mvindex(Account_Name,1))
| eval src_ip=coalesce(IpAddress, Source_Network_Address, src)
| eval dest_host=host
| eval logon_type=tostring(coalesce(LogonType, Logon_Type))
| where isnotnull(account) AND account!="" AND account!="-"
    AND isnotnull(src_ip) AND src_ip!="" AND src_ip!="-"
    AND (logon_type="3" OR logon_type="10")
| eval is_failure=if(EventCode=4625,1,0)
| sort 0 +_time
| streamstats time_window=10m current=f
    sum(is_failure) AS failed_before_success
    BY account src_ip dest_host logon_type
| where EventCode=4624 AND failed_before_success>=3
| table _time account src_ip dest_host logon_type failed_before_success
| sort - _time